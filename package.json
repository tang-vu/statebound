{
  "name": "statebound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:holdout": "tsx scripts/evaluate.ts",
    "demo:verify": "tsx src/cli.ts demo",
    "plan:check": "tsx src/cli.ts check",
    "plan:repair": "tsx src/cli.ts repair",
    "evidence:verify": "tsx src/cli.ts verify",
    "replay": "tsx src/cli.ts replay",
    "integration:inspect": "tsx scripts/integration.ts",
    "test:browser": "tsx scripts/browser.ts",
    "demo:record": "tsx scripts/record-demo.ts",
    "test:http": "tsx scripts/http-test.ts",
    "mandate:compile": "tsx src/cli.ts compile",
    "preview": "node scripts/preview.mjs",
    "test:preview": "node scripts/preview-test.mjs",
    "ops:start": "pm2 start ecosystem.config.cjs",
    "ops:restart": "pm2 restart statebound-workbench statebound-preview"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "fast-check": "4.9.0",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
